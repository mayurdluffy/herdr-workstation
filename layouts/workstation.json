{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "ws-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "ws-spaces"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 41
          },
          "content": {
            "mod": "ws-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "ws-tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "ws-pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "ws-files"
                      }
                    },
                    {
                      "id": "ws-review",
                      "type": "block",
                      "content": {
                        "mod": "ws-review"
                      }
                    },
                    {
                      "id": "ws-graph",
                      "type": "block",
                      "content": {
                        "mod": "ws-git-graph"
                      }
                    },
                    {
                      "id": "ws-comments",
                      "type": "block",
                      "content": {
                        "mod": "ws-comments"
                      }
                    },
                    {
                      "id": "ws-prs",
                      "type": "block",
                      "content": {
                        "mod": "ws-prs"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "row",
          "size": {
            "px": 28
          },
          "resizable": false,
          "children": [
            {
              "id": "status-left",
              "type": "block",
              "size": {
                "weight": 1
              },
              "content": {
                "mod": "workspace-status"
              }
            },
            {
              "id": "activity",
              "type": "block",
              "size": {
                "px": 210
              },
              "content": {
                "mod": "ws-activity"
              }
            },
            {
              "id": "usage",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 120,
              "content": {
                "mod": "usage-limits"
              }
            }
          ]
        }
      ]
    }
  ],
  "link_handlers": [
    "ws-md-preview"
  ],
  "preview": "layouts/workstation.svg"
}
